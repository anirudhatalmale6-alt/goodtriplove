APP_NAME=GoodTripLove
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://goodtriplove.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
GTL_DEFAULT_LOCALE=fr

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=admin_goodtrip
DB_USERNAME=admin_goodtrip
DB_PASSWORD=

# No Redis and no Supervisor on the target server: the database driver plus a
# cron-driven queue:work is the supported setup.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=noreply@goodtriplove.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@goodtriplove.com
MAIL_FROM_NAME=GoodTripLove

# --- Video collector -------------------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA=10000
YOUTUBE_QUOTA_WARNING_PERCENT=80
YOUTUBE_QUOTA_HARD_STOP_PERCENT=95

# --- Local AI --------------------------------------------------------------
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT=90
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREAD=2
OLLAMA_MAX_PER_RUN=20

# --- Security --------------------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SECURITY_ADMIN_ALERT_EMAIL=admin@goodtriplove.com
SECURITY_BLOCK_MINUTES=30
SECURITY_LOGIN_MAX_ATTEMPTS=5
SECURITY_EMAIL_CODE_TTL_MINUTES=10
SECURITY_EMAIL_CODE_MAX_ATTEMPTS=5
SECURITY_LOG_RETENTION_DAYS=180

SECURITY_CENTER_ALERT_EMAIL=admin@goodtriplove.com
SECURITY_CENTER_REQUIRE_ADMIN_2FA=true
SECURITY_CENTER_NEW_DEVICE_ALERT=true
SECURITY_CENTER_LOG_IMMUTABLE=true
SECURITY_CENTER_BACKUP_PATH=storage/app/security-backups

# --- Legal (must be completed before going public) -------------------------
GTL_COOKIE_POLICY_VERSION=1.0
GTL_LEGAL_PUBLISHER=
GTL_LEGAL_ADDRESS=
GTL_LEGAL_REGISTRATION=
GTL_LEGAL_DIRECTOR=
GTL_LEGAL_HOST=
GTL_LEGAL_CONTACT=contact@goodtriplove.com
GTL_LEGAL_DPO=

# --- Mobile app ------------------------------------------------------------
GTL_ANDROID_STORE_URL=
GTL_IOS_STORE_URL=
GTL_APK_ENABLED=false

USER_HISTORY_RETENTION_DAYS=90
